{
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-write --allow-net=127.0.0.1 src/main.ts --http --state ../../target/frances-dev-mcp-state.json",
    "stdio": "deno run --allow-read --allow-write src/main.ts --stdio",
    "check": "deno check src/*.ts build.ts",
    "test": "deno test --allow-run --allow-read --allow-write --allow-net=127.0.0.1 src/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "fmt": { "lineWidth": 100, "singleQuote": true }
}
