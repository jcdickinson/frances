{
  "nodeModulesDir": "auto",
  "imports": {
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.0.0",
    "@tauri-apps/api/": "npm:@tauri-apps/api@^2.0.0/",
    "@tauri-apps/cli": "npm:@tauri-apps/cli@^2.0.0",
    "@types/node": "npm:@types/node@^24.0.0",
    "sass": "npm:sass@^1.0.0",
    "svelte": "npm:svelte@^5.0.0",
    "vite": "npm:vite@^7.0.0"
  },
  "tasks": {
    "app": "cd ../crates/frances && deno run -A npm:@tauri-apps/cli@^2.0.0 dev -- -- --foreground",
    "dev": "deno run -A npm:vite@^7.0.0",
    "build": "deno run -A npm:vite@^7.0.0 build",
    "check": "deno check src/main.ts && deno run -A npm:svelte-check@^4.0.0 --tsconfig ./tsconfig.json",
    "fmt": "deno fmt",
    "lint": "deno lint src vite.config.ts",
    "tauri": "cd ../crates/frances && deno run -A npm:@tauri-apps/cli@^2.0.0"
  },
  "fmt": {
    "exclude": [".vite", "dist", "node_modules", "src/bindings.ts"],
    "lineWidth": 100,
    "singleQuote": true
  },
  "lint": {
    "include": ["src/**/*.ts", "vite.config.ts"],
    "exclude": ["src/bindings.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "unstable": ["fmt-component"]
}
